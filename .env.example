# ---------------------------------------------------------------------------
# FableKeeper environment variables
# Copy this file to `.env.local` for local development and set real values.
# On Cloudflare, set public vars in wrangler.toml [vars] and secrets with
# `wrangler secret put <NAME>`.
# ---------------------------------------------------------------------------

# Public app metadata
NEXT_PUBLIC_APP_NAME="FableKeeper"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (required) ---------------------------------------------------
# Project URL and the publishable/anon key are safe to expose to the browser;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only. NEVER expose to the client or commit a real value.
# Used by trusted server code / Edge Functions that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- AI providers (optional) -----------------------------------------------
# Server-only secret powering the AI Assist module. Everything else in
# FableKeeper works without it; the AI Assist page says so when it's missing.
# On Cloudflare set it with `wrangler secret put ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=""

# --- Cloudflare (optional, deployment) -------------------------------------
# Used by `wrangler` for CI/programmatic deploys.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
